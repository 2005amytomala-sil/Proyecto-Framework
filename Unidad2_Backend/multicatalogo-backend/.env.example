# Produccion (Render): APP_ENV=production, JWT_SECRET obligatorio (>=32 caracteres),
# DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require  (Neon)
# FRONTEND_ORIGINS=https://TU-APP.vercel.app
